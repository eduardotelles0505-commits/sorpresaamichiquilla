# --- 3. Función del acertijo ---
def obtener_movimientos_validos():
    """Calcula todas las jugadas válidas según las reglas de Hanoi."""
    movimientos_validos = []
    
    for origen in range(3):
        if pilas[origen].esta_vacia():
            continue
        
        disco_origen = pilas[origen].cima()

        for destino in range(3):
            if origen == destino:
                continue
            
            disco_destino = pilas[destino].cima()

            # Regla: Se puede mover a una torre vacía o sobre un disco más grande
            if disco_destino is None or disco_origen < disco_destino:
                movimientos_validos.append((origen, destino))
                
    return movimientos_validos


def resolver_aleatorio(max_intentos=150, velocidad=0.7):
    movimientos_realizados = []
    ultimo_movimiento = "Inicio del juego"
    
    # El objetivo es lograr que todos los n discos estén apilados en la Torre 3 (índice 2)
    while len(pilas[2].items) < n and len(movimientos_realizados) < max_intentos:
        pintar_torres(movimientos_realizados, ultimo_movimiento)
        time.sleep(velocidad)

        opciones = obtener_movimientos_validos()

        # Evitar deshacer inmediatamente el último movimiento para reducir ciclos redundantes
