import os
import random
import time

# --- 1. Crear  pila ---
class Pila:
    def __init__(self):
        self.items = []

    def apilar(self, valor):
        self.items.append(valor)

    def desapilar(self):
        if not self.esta_vacia():
            return self.items.pop()
        return None

    def cima(self):
        return self.items[-1] if self.items else None

    def esta_vacia(self):
        return len(self.items) == 0


# --- 2. Animación de los discos ---
def crear_discos(n):
    filas = n + 1
    columnas = 2 * n + 3
    matriz = []

    for i in range(filas):
        torre = []
        centro = columnas // 2
        for j in range(columnas):
            if i == 0:
                if j == centro:
                    torre.append("|")
                else:
                    torre.append(" ")
            else:
                limite_izq = centro - i
                limite_der = centro + i
                if j == limite_izq:
                    torre.append("[")
                elif j == limite_der:
                    torre.append("]")
                elif limite_izq < j < limite_der:
                    torre.append("=")
                else:
                    torre.append(" ")
        matriz.append("".join(torre))
    return matriz


